{
  "name": "hahapewpew",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the API needs the Worker; static files are served straight from assets.
    "run_worker_first": ["/api/*"]
  }
}
